VITE_API_BASE_URL=https://api.punto-plus.com.mx
# Modo de datos: "api" (por defecto) consume el backend real y exige sesión para
# entrar a los paneles; "demo" usa fixtures locales, sin backend ni protección.
VITE_DATA_MODE=api

# --- Autenticación (Laravel Passport) ---
# "passport" (default) -> POST /oauth/token con grant_type=password.
# "json"               -> controlador propio del backend (recomendado para una SPA).
VITE_AUTH_LOGIN_MODE=passport
# Rutas por defecto según el modo:
#   passport -> login y refresh en /oauth/token
#   json     -> /api/login y /api/refresh
# Déjalas vacías para usar esas rutas, o fíjalas si tu backend usa otras.
VITE_AUTH_LOGIN_PATH=
VITE_AUTH_REFRESH_PATH=
VITE_AUTH_REGISTER_PATH=/api/register
VITE_AUTH_LOGOUT_PATH=/api/logout
VITE_AUTH_PROFILE_PATH=/api/me
# Client de Passport para el password grant. Todo VITE_* es público: nunca pongas aquí
# un client_secret real. Con VITE_AUTH_LOGIN_MODE=json el secreto se queda en el backend.
VITE_PASSPORT_CLIENT_ID=
VITE_PASSPORT_CLIENT_SECRET=
VITE_PASSPORT_SCOPE=
